pragma language_version >= 0.26;

import CompactStandardLibrary;

// Test-only adopter WITHOUT access control: anyone can call emitPart. It emits the
// reference emitter's name, so the tests can put a stranger's parts into another
// intent of my transaction under the same contract and the same name. Never deploy it.
export circuit emitPart(payload: Bytes<256>): [] {
  emit (Misc { name: pad(32, "example:message[v1]"), payload: disclose(payload) });
}
