pragma language_version >= 0.26;

// Measurement contract: circuit size (k, rows) of the generic
// MessageRegistry.registerMessage<N> for selected N. Compiled with --skip-zk and
// measured with `zkir-v3 mock-compile`; never deployed.
import CompactStandardLibrary;
import "../../contracts/modules/MessageRegistry";

export circuit register1(requestId: Bytes<32>, tails: Vector<1, Bytes<224>>): [] {
  registerMessage<1>(requestId, tails);
}

export circuit register2(requestId: Bytes<32>, tails: Vector<2, Bytes<224>>): [] {
  registerMessage<2>(requestId, tails);
}

export circuit register3(requestId: Bytes<32>, tails: Vector<3, Bytes<224>>): [] {
  registerMessage<3>(requestId, tails);
}

export circuit register4(requestId: Bytes<32>, tails: Vector<4, Bytes<224>>): [] {
  registerMessage<4>(requestId, tails);
}

export circuit register8(requestId: Bytes<32>, tails: Vector<8, Bytes<224>>): [] {
  registerMessage<8>(requestId, tails);
}

export circuit register16(requestId: Bytes<32>, tails: Vector<16, Bytes<224>>): [] {
  registerMessage<16>(requestId, tails);
}

export circuit register32(requestId: Bytes<32>, tails: Vector<32, Bytes<224>>): [] {
  registerMessage<32>(requestId, tails);
}

export circuit register46(requestId: Bytes<32>, tails: Vector<46, Bytes<224>>): [] {
  registerMessage<46>(requestId, tails);
}
