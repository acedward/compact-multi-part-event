pragma language_version >= 0.26;

// Consumer example: a notice board where several users publish long notices.
//
// It reuses the shared modules unchanged: MultiSegmentEmit for the event format and
// MessageRegistry (optional per-message registration) for access control. The board
// keeps application state of its own, which the emission circuit never touches.
//
// Flow, one transaction each, in this order:
//   1. register<N>(requestId, tails)  the owner registers the notice (tails stay private)
//   2. emitPart(requestId, tail) x N  the owner publishes the parts in ONE transaction
//   3. announce(requestId)            optional application step, after the publication
//   4. release(requestId)             optional owner-only cleanup, after every part
//
// Every part of a publication is executed from the same pre-state. That is valid only
// because emitPart reads the registry and writes nothing; announce and release write
// state and must never be batched with the parts.
import CompactStandardLibrary;
import "../../../contracts/modules/MultiSegmentEmit";
import "../../../contracts/modules/MessageRegistry";

// Application state.
export ledger announcements: Counter;
export ledger latestAnnouncement: Bytes<32>;

export { messageOwnerOf, messageOwner };

// Registration sizes this board accepts (N parts = up to N * 208 message bytes).
export circuit register1(requestId: Bytes<32>, tails: Vector<1, Bytes<224>>): [] {
  registerMessage<1>(requestId, tails);
}

export circuit register2(requestId: Bytes<32>, tails: Vector<2, Bytes<224>>): [] {
  registerMessage<2>(requestId, tails);
}

export circuit register3(requestId: Bytes<32>, tails: Vector<3, Bytes<224>>): [] {
  registerMessage<3>(requestId, tails);
}

export circuit register5(requestId: Bytes<32>, tails: Vector<5, Bytes<224>>): [] {
  registerMessage<5>(requestId, tails);
}

export circuit emitPart(requestId: Bytes<32>, payload: Bytes<224>): [] {
  assertMessageOwner(requestId);
  emitPartEvent(requestId, payload);
}

export circuit announce(requestId: Bytes<32>): [] {
  assertMessageOwner(requestId);
  announcements.increment(1);
  latestAnnouncement = disclose(requestId);
}

export circuit release(requestId: Bytes<32>): [] {
  releaseMessage(requestId);
}
