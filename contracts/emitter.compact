pragma language_version >= 0.26;

import CompactStandardLibrary;
import "modules/MultiSegmentEmit";
import "modules/EmitterWhitelist";

// Minimal deployable emitter with the single-emitter whitelist example.
// `authority` is emitterAuthorityOf(secret), computed off-chain; the secret
// never reaches the chain.
constructor(authority: Bytes<32>) {
  initializeEmitterAuthority(authority);
}

export { emitterAuthorityOf, emitterAuthority };

export circuit emitPart(requestId: Bytes<32>, payload: Bytes<224>): [] {
  assertEmitterAuthority();
  emitPartEvent(requestId, payload);
}
