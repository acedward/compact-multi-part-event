# Dependencies
node_modules/

# Build output
dist/
build/
*.tsbuildinfo
coverage/

# Compiler output. Regenerate with `npm run compile` (skip-zk) or `npm run compile:zk`.
# Verifier keys and their hashes are committed separately under contract-examples/*/keys/.
contract-examples/*/managed/
contract-examples/*/dist/
contract-examples/*/node_modules/
tests/contracts/managed/

# Downloaded toolchains and caches
.cache/

# Runtime secrets and local configuration: never commit
.env
.env.*
*.secret
*.mnemonic

# Editor and OS clutter
.DS_Store
.idea/
.vscode/
