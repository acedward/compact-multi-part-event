{
  "name": "compact-multi-segment-emit",
  "version": "0.1.0",
  "private": true,
  "description": "Reference implementation of the multi-part rule for Midnight Misc events: a reader that merges one intent's events of an opted-in name into one package, a publisher that puts all parts of a package into one guaranteed-only intent, a public-indexer client and the `cmse verify` command.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "bin": {
    "cmse": "dist/cli/main.js"
  },
  "exports": {
    "./reader": {
      "types": "./dist/reader/index.d.ts",
      "default": "./dist/reader/index.js"
    },
    "./publisher": {
      "types": "./dist/publisher/index.d.ts",
      "default": "./dist/publisher/index.js"
    },
    "./indexer": {
      "types": "./dist/indexer/index.d.ts",
      "default": "./dist/indexer/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "compile": "scripts/compile-contracts.sh",
    "compile:zk": "scripts/compile-contracts.sh --zk",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:real-proof": "vitest run tests/real-proof.test.ts",
    "cmse": "node dist/cli/main.js",
    "deploy-tools": "tsx deploy-tools/main.ts",
    "check": "scripts/check.sh",
    "check:repo": "scripts/check-repo.sh",
    "check:external-consumer": "scripts/check-external-consumer.sh"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-runtime": "0.19.0",
    "@midnightntwrk/ledger-v9": "1.0.0-rc.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "5.0.0-beta.7",
    "@midnight-ntwrk/midnight-js-node-zk-config-provider": "5.0.0-beta.7",
    "@midnight-ntwrk/midnight-js-types": "5.0.0-beta.7",
    "@midnightntwrk/wallet-sdk-abstractions": "3.0.0-beta.0",
    "@midnightntwrk/wallet-sdk-address-format": "4.0.0-beta.2",
    "@midnightntwrk/wallet-sdk-dust-wallet": "5.0.0-beta.2",
    "@midnightntwrk/wallet-sdk-facade": "5.0.0-beta.2",
    "@midnightntwrk/wallet-sdk-hd": "3.1.0-beta.1",
    "@midnightntwrk/wallet-sdk-shielded": "4.0.0-beta.2",
    "@midnightntwrk/wallet-sdk-unshielded-wallet": "4.0.0-beta.2",
    "@scure/bip39": "2.4.0",
    "@types/node": "24.13.6",
    "eslint": "10.8.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.6",
    "rxjs": "7.8.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  },
  "overrides": {
    "@midnight-ntwrk/compact-runtime": "0.19.0",
    "@midnightntwrk/ledger-v9": "1.0.0-rc.3",
    "@midnightntwrk/onchain-runtime-v4": "4.0.0-rc.3"
  }
}
