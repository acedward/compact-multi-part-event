{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "allowJs": false,
    "noEmit": true,
    "paths": {
      "compact-multi-segment-emit/reader": ["./src/reader/index.ts"],
      "compact-multi-segment-emit/publisher": ["./src/publisher/index.ts"],
      "compact-multi-segment-emit/indexer": ["./src/indexer/index.ts"]
    }
  },
  "include": ["src", "tests", "contract-examples", "deploy-tools", "vitest.config.ts"],
  "exclude": [
    "contract-examples/*/dist",
    "contract-examples/*/node_modules",
    "src/cli",
    "deploy-tools/commands.ts",
    "deploy-tools/config.ts",
    "deploy-tools/contracts.ts",
    "deploy-tools/main.ts",
    "tests/cli-commands.test.ts",
    "tests/helpers/offline-services.ts"
  ]
}
