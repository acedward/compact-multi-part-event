# Copy to a file OUTSIDE this repository (for example ~/.config/cmse/stagenet.env),
# fill in the paths, and load it into your shell (set -a; . <file>; set +a).
# Every CMSE_* variable can also be passed as the matching --flag (see `cmse --help`).
#
# Secrets are NEVER written here: only the PATHS of protected files (mode 0600, in a
# directory outside every Git working tree). The CLI refuses secret files that group or
# others can read, symlinks, and paths inside a Git working tree.

# Network and public endpoints (these are stagenet's defaults).
CMSE_NETWORK=stagenet
CMSE_INDEXER_URL=https://indexer.stagenet.shielded.tools/api/v4/graphql
CMSE_INDEXER_WS_URL=wss://indexer.stagenet.shielded.tools/api/v4/graphql/ws
CMSE_NODE_URL=https://rpc.stagenet.shielded.tools

# Your own local proof server (it sees your witness secrets; see scripts/docker/proof-server.sh).
CMSE_PROOF_SERVER_URL=http://127.0.0.1:<port>
CMSE_PROOF_CONCURRENCY=4

# Full key build used for proving (npm run compile:zk); defaults to build/zk/<contract>.
# CMSE_ZK_DIR=

# Wallet sync: every wallet command waits for a COMPLETE sync (the first one downloads every
# ledger event and can take long; progress is printed every 30 s). Minutes, 1..1440.
CMSE_SYNC_TIMEOUT_MINUTES=60

# Protected files, referenced by path only.
CMSE_WALLET_MNEMONIC_FILE=/path/outside/any/repository/wallet.mnemonic
# Optional wallet-state cache (private wallet data, no keys): restored on the next run.
# CMSE_WALLET_CACHE_FILE=/path/outside/any/repository/stagenet.wallet-cache.json
CMSE_EMITTER_SECRET_FILE=/path/outside/any/repository/emitter.secret
CMSE_OWNER_SECRET_FILE=/path/outside/any/repository/owner.secret
CMSE_MAINTENANCE_KEY_FILE=/path/outside/any/repository/maintenance-key.json
